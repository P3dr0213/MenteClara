{
  "name": "MenteClara",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "start": "expo start",
    "test": "jest",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database.ps1 setup",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database.ps1 status",
    "db:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database.ps1 test",
    "db:console": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database.ps1 console",
    "api:start": "node backend/server.js",
    "api:test": "node --test backend/tests/api.test.cjs",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3001 tcp:3001 && expo start --localhost --android",
    "typecheck": "tsc --noEmit",
    "api:lan": "node scripts/start-api-lan.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/eslint-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jest-expo": "~57.0.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.js"
}
